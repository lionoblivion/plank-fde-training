{
  "mcpServers": {
    "database": {
      "command": "node",
      "args": [
        "--env-file-if-exists=.env.local",
        "--import",
        "tsx",
        "mcp/database.ts"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local"
    },
    "posthog": {
      "command": "node",
      "args": [
        "--env-file-if-exists=.env.local",
        "--import",
        "tsx",
        "mcp/posthog.ts"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local"
    }
  }
}
