# Скопируйте в .env.local и подставьте значения.
# Docker Postgres: docker compose up -d
DATABASE_URL=postgres://postgres@localhost:5433/workbot

# Без DATABASE_URL приложение поднимет встроенный PGlite в .data/pg.
# Тесты всегда используют memory:// (см. vitest setup).

# PostHog project API key (capture). Курс: POSTHOG_KEY.
# POST_HOG_API — допустимый alias (см. src/lib/config.ts).
POSTHOG_KEY=
# Capture host (EU: https://eu.i.posthog.com)
# POSTHOG_HOST=https://us.i.posthog.com

# PostHog MCP (read): personal key + project id — не коммитить
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_KEY=
# Опционально явный API host (по умолчанию выводится из POSTHOG_HOST)
# POSTHOG_API_HOST=https://eu.posthog.com

# LLM providers (сервер; см. src/lib/providers.ts)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Tavily Search API (опционально; без ключа tool web_search не регистрируется)
# TAVILY_API_KEY=
