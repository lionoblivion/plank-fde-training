# Скопируйте в .env.local и подставьте значения.
# Docker Postgres: docker compose up -d
DATABASE_URL=postgres://postgres@localhost:5433/workbot

# Без DATABASE_URL приложение поднимет встроенный PGlite в .data/pg.
# Тесты всегда используют memory:// (см. vitest setup).

# PostHog project API key (capture). Курс: POSTHOG_KEY.
# POST_HOG_API — допустимый alias (см. src/lib/config.ts).
POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
